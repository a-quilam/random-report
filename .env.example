# Рабочий пример переменных окружения. Реальных секретов здесь нет и быть не должно.
# Секреты процесса берутся из secret store сервисного пользователя (docs/RUNBOOK.md),
# не из чата, не из аргументов командной строки и не из git.

RANREPORT_DB=/var/lib/randreport/randreport.sqlite

# Zenmoney: отдельный уже настроенный аккаунт РанДома, read-only клиент
ZENMONEY_TOKEN=placeholder-zenmoney-token
ZENMONEY_BASE_URL=https://api.zenmoney.ru

# Teamup: секретный calendar key не публикуется и не попадает в логи.
# TEAMUP_CALENDAR_ID — устойчивая внутренняя идентичность календаря (не секрет):
# именно она попадает в хранилище, отметки проверки и админский стол. Ротация
# секретного ключа не меняет её, иначе история распалась бы на два календаря.
TEAMUP_CALENDAR_KEY=placeholder-calendar-key
TEAMUP_CALENDAR_ID=cal_community
TEAMUP_TOKEN=placeholder-teamup-token
TEAMUP_BASE_URL=https://api.teamup.com

# Календарь: конфигурация только по устойчивым ID подкалендарей (placeholder,
# настоящих значений здесь нет). Формат: `id=тип` через запятую. Русские типы:
# open|open_by_registration|closed|internal_meeting|preparation|unknown.
TEAMUP_SUBCALENDAR_TYPES=placeholder-sub-open=open,placeholder-sub-closed=closed
TEAMUP_PRIVATE_SUBCALENDARS=placeholder-sub-closed,placeholder-sub-internal
# Исключённый подкалендарь не даёт ни списков, ни итогов.
TEAMUP_EXCLUDED_SUBCALENDARS=placeholder-sub-excluded
# Разрешённый контур закрытых событий: только здесь запись с точным названием
# «Собрания» становится типом meeting и попадает в публичный календарь как дата.
TEAMUP_MEETING_SUBCALENDARS=placeholder-sub-meetings
# Закрытые аренды — отдельная категория по маппингу; не каждое закрытое аренда.
TEAMUP_RENT_SUBCALENDARS=placeholder-sub-rent
# Точные названия собраний и публичная константа. По умолчанию совпадение
# целиком (`exact`, осторожнее); `contains` — записанный владельцем вариант
# (`source_title_contains_word`, без учёта регистра) — он включается
# только явно и никогда по умолчанию.
TEAMUP_MEETING_TITLES=Собрания
TEAMUP_MEETING_LABEL=Собрание
TEAMUP_MEETING_MATCH=exact
# Приоритет карты календаря: записанная версия стола в БД → приватный файл
# (RANREPORT_EVENT_MAPPING / --events) → переменные TEAMUP_* выше. Файл — тот же
# payload, что хранит стол (config/calendar_mapping.example.json); реальных
# значений в примере нет. Путь задаётся только в окружении службы, не здесь.

# Telegram: Bot API только для суточного снимка подписчиков и только чтения.
# TELEGRAM_PUBLIC_CHANNEL — единственный разрешённый канал (allowlist): апдейт
# другого канала отклоняется. Через запятую можно указать несколько значений.
TELEGRAM_BOT_TOKEN=placeholder-bot-token
TELEGRAM_PUBLIC_CHANNEL=@placeholder_channel
TELEGRAM_BASE_URL=https://api.telegram.org
# Приём публичных постов (§8): webhook пишет channel_post/edited_channel_post в
# приватный inbox, обработка — только в ночном цикле 03:00. Webhook НЕ
# регистрируется: setWebhook не вызывается, исходящих запросов нет.
# Секрет обязателен (>=16 символов), иначе служба не стартует: Telegram присылает
# его в заголовке X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=placeholder-webhook-secret-at-least-16
TELEGRAM_WEBHOOK_MAX_BODY_BYTES=16384
RANREPORT_WEBHOOK_HOST=127.0.0.1
RANREPORT_WEBHOOK_PORT=8081
# 1 — только если есть согласованная read-only сессия истории (MTProto) на весь
# период. Пока в поставке заглушка (is_placeholder), флаг не поднимает полноту:
# раздел новостей остаётся partial с явным gap.
TELEGRAM_HISTORY_VERIFIED=0

# Новости: провайдер опционален. Без него раздел новостей помечается неполным
# (явный gap), финансы и календарь работают как обычно.
# Бюджет по умолчанию 0: пока не выставлено явное положительное число платных
# вызовов в сутки, адаптер не делает ни одного запроса.
NEWS_LLM_PROVIDER=none
NEWS_LLM_API_KEY=placeholder-llm-key
NEWS_LLM_BASE_URL=https://placeholder-provider.invalid
NEWS_LLM_MODEL=placeholder-model
NEWS_LLM_API_PATH=/v1/chat/completions
NEWS_LLM_TIMEOUT_S=30
NEWS_LLM_RETRIES=2
# 0 платных вызовов в сутки — безопасное значение по умолчанию: пока здесь не
# выставлено явное положительное целое, адаптер не делает ни одного запроса.
NEWS_LLM_MAX_CALLS_PER_DAY=0
# Дополнительный лимит токенов в сутки задаётся так (0 или отсутствие — без
# отдельного лимита; гейтом остаётся число вызовов). Строка закомментирована,
# потому что имя содержит «TOKENS» и тест гигиены секретов требует, чтобы такое
# значение было только placeholder-ом:
# NEWS_LLM_MAX_TOKENS_PER_DAY=<целое число токенов в сутки>

# Публикация
RANREPORT_PUBLISH_DIR=/var/www/randreport
# Публичный веб-процесс читает только каталог релиза (allowlist store) и НЕ читает
# RANREPORT_DB: страницы /reports/* строятся из reports.json внутри релиза.
RANREPORT_RELEASE_DIR=/var/www/randreport
RANREPORT_HOST=127.0.0.1
RANREPORT_PORT=8099
# Двойной явный отказ нужен, чтобы выставить публичный или административный процесс
# на не-loopback адрес: только этот флаг вместе с --allow-external-bind CLI.
RANREPORT_ALLOW_EXTERNAL_BIND=0

# Бэкап (§6). Пароль шифрования — только здесь, не в аргументах и не в чате.
RANREPORT_BACKUP_DIR=/var/backups/randreport
RANREPORT_BACKUP_PASSPHRASE=placeholder-backup-passphrase
RANREPORT_BACKUP_KEEP_DAILY=14
RANREPORT_BACKUP_KEEP_MONTHLY=1

# Карта публичного контура (§6.2). Файл приватный, в репозитории его нет.
# Используется, только пока в БД нет записанной версии сопоставления: версия,
# записанная редакционным столом, всегда приоритетна и не перезаписывается ночью.
RANREPORT_FINANCE_POLICY=/etc/randreport/finance_policy.json

# Только для интеграционного процесса; публичный веб-процесс их не читает.
TELEGRAM_AUTH_BOT_TOKEN=placeholder-auth-token
ADMIN_BOOTSTRAP_TELEGRAM_ID=placeholder-id

# Редакционный стол (§11). Секрет подписи cookie обязателен: без него стол не
# стартует. OIDC-значения берутся из документации провайдера в момент подключения;
# redirect URI должен быть в allowlist.
RANREPORT_ADMIN_SECRET=placeholder-server-secret-at-least-16-chars
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
TELEGRAM_OIDC_CLIENT_ID=placeholder-oidc-client-id
TELEGRAM_OIDC_REDIRECT_URI=https://desk.example/admin/callback
TELEGRAM_OIDC_REDIRECT_ALLOWLIST=https://desk.example/admin/callback
# Только локальный staging: разрешить http на 127.0.0.1 и не ставить Secure в cookie.
RANREPORT_ALLOW_INSECURE_LOOPBACK=0
RANREPORT_INSECURE_COOKIES=0
RANREPORT_ADMIN_HOST=127.0.0.1
RANREPORT_ADMIN_PORT=8098
