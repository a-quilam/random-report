# Рабочий пример переменных окружения. Реальных секретов здесь нет и быть не должно.
# Секреты процесса берутся из secret store сервисного пользователя (docs/RUNBOOK.md),
# не из чата, не из аргументов командной строки и не из git.

RANREPORT_DB=/var/lib/randreport/randreport.sqlite

# Zenmoney: отдельный уже настроенный аккаунт РанДома, read-only клиент
ZENMONEY_TOKEN=placeholder-zenmoney-token
ZENMONEY_BASE_URL=https://api.zenmoney.ru

# Teamup: секретный calendar key не публикуется и не попадает в логи
TEAMUP_CALENDAR_KEY=placeholder-calendar-key
TEAMUP_TOKEN=placeholder-teamup-token
TEAMUP_BASE_URL=https://api.teamup.com

# Telegram: Bot API только для суточного снимка подписчиков и только чтения
TELEGRAM_BOT_TOKEN=placeholder-bot-token
TELEGRAM_PUBLIC_CHANNEL=@placeholder_channel

# Новости: провайдер опционален. Без него раздел новостей помечается неполным,
# финансы и календарь работают как обычно.
NEWS_LLM_PROVIDER=none
NEWS_LLM_API_KEY=placeholder-llm-key
NEWS_LLM_MODEL=placeholder-model
NEWS_LLM_MAX_CALLS_PER_DAY=50

# Публикация
RANREPORT_PUBLISH_DIR=/var/www/randreport

# Только для интеграционного процесса; публичный веб-процесс их не читает.
TELEGRAM_AUTH_BOT_TOKEN=placeholder-auth-token
ADMIN_BOOTSTRAP_TELEGRAM_ID=placeholder-id

# Редакционный стол (§11). Секрет подписи cookie обязателен: без него стол не
# стартует. OIDC-значения берутся из документации провайдера в момент подключения;
# redirect URI должен быть в allowlist.
RANREPORT_ADMIN_SECRET=placeholder-server-secret-at-least-16-chars
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
TELEGRAM_OIDC_CLIENT_ID=placeholder-oidc-client-id
TELEGRAM_OIDC_REDIRECT_URI=https://desk.example/admin/callback
TELEGRAM_OIDC_REDIRECT_ALLOWLIST=https://desk.example/admin/callback
# Только локальный staging: разрешить http на 127.0.0.1 и не ставить Secure в cookie.
RANREPORT_ALLOW_INSECURE_LOOPBACK=0
RANREPORT_INSECURE_COOKIES=0
RANREPORT_ADMIN_HOST=127.0.0.1
RANREPORT_ADMIN_PORT=8098
