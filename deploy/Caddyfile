# Публичный TLS-терминатор RanDom (отдельный экземпляр Caddy, только проекция).
#
# Конфигурация НЕ трогает /etc/caddy/Caddyfile (чужая служба остаётся выключенной,
# как была найдена). Экземпляр обслуживает ровно один хост и проксирует его на
# loopback-порт публичного процесса ranreport-public.service (127.0.0.1:8099);
# редакционный стол (8098) и приватная БД наружу не выходят.
#
# Адрес — sslip.io для публичного IP этого VPS: он не требует своего домена,
# резолвится в тот же IP и позволяет Caddy получить обычный сертификат Let's
# Encrypt по ACME (HTTP-01 на порту 80). Проверить после запуска:
#   curl -sSI https://rand.185.121.13.113.sslip.io/ | head -1
{
	# управляющий API не нужен: конфигурация подаётся один раз при старте
	admin off
}

rand.185.121.13.113.sslip.io {
	# HSTS добавляет терминатор (приложение его не ставит; docs/DEPLOYMENT.md §5).
	# includeSubDomains не добавляется: sslip.io — общий публичный домен.
	header Strict-Transport-Security "max-age=31536000"
	# прочие защитные заголовки (CSP, nosniff, Referrer-Policy, X-Frame-Options,
	# X-Robots-Tag, ETag) ставит само приложение и они проходят как есть

	reverse_proxy 127.0.0.1:8099
}
