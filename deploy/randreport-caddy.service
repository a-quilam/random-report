# Шаблон. Публичный TLS-терминатор: отдельный экземпляр Caddy только для
# проекции. Не использует /etc/caddy/Caddyfile и не включает системную службу
# caddy (чужая конфигурация остаётся нетронутой). Слушает :80/:443
# (capability CAP_NET_BIND_SERVICE вместо root) и проксирует только публичный
# loopback-порт 127.0.0.1:8099.
#
# Проверить сертификат и HSTS:
#   curl -sSI https://rand.185.121.13.113.sslip.io/ | head -1
#   | grep -i strict-transport / grep -i content-security
[Unit]
Description=RanDom public TLS terminator (Caddy, allowlist projection only)
Wants=network-online.target
After=network-online.target randreport-public.service
Requires=randreport-public.service

[Service]
Type=simple
User=caddy
Group=caddy
Environment=HOME=/var/lib/caddy
Environment=XDG_DATA_HOME=/var/lib/caddy/.local/share
Environment=XDG_CONFIG_HOME=/var/lib/caddy/.config
ExecStart=/usr/bin/caddy run --config /etc/randreport/Caddyfile --adapter caddyfile
# писать состояние только в домашний каталог службы caddy
ReadWritePaths=/var/lib/caddy
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
